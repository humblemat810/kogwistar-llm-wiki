FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LLM_WIKI_REPRESENTATION_DEVICE=cpu \
    LLM_WIKI_REPRESENTATION_TORCH_BACKEND=cpu

WORKDIR /app
ARG LLM_WIKI_REPRESENTATION_TORCH_BACKEND=cpu
ENV LLM_WIKI_REPRESENTATION_TORCH_BACKEND=${LLM_WIKI_REPRESENTATION_TORCH_BACKEND}

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl gcc libc6-dev \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/root/.cargo/bin:${PATH}"

COPY pyproject.toml README.md .env.example ./
COPY kogwistar ./kogwistar
COPY kg-doc-parser ./kg-doc-parser
COPY kogwistar-obsidian-sink ./kogwistar-obsidian-sink
COPY src ./src
COPY requirements ./requirements

RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir "maturin>=1.8,<2" \
    && python -m pip install --no-cache-dir --no-build-isolation -e "./kogwistar[full]" \
    && python -m pip install --no-cache-dir -e ./kg-doc-parser \
    && python -m pip install --no-cache-dir -e ./kogwistar-obsidian-sink \
    && python -m pip install --no-cache-dir -e . --no-deps \
    && python -m pip install --no-cache-dir -r requirements/multimodal/torch-${LLM_WIKI_REPRESENTATION_TORCH_BACKEND}.txt \
    && python -m pip install --no-cache-dir \
       "fastapi>=0.115,<1" "uvicorn[standard]>=0.30,<1" \
       "transformers>=4.57.0" "qwen-vl-utils>=0.0.14" \
       "accelerate>=1.10,<2" "Pillow>=10" "huggingface_hub>=0.26"

RUN python -c "from kogwistar_llm_wiki.representation_service import load_config; print(load_config())"

RUN useradd --create-home --uid 10001 llmwiki \
    && mkdir -p /var/lib/huggingface \
    && chown -R llmwiki:llmwiki /app /var/lib/huggingface
USER llmwiki

EXPOSE 8790
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8790/healthz', timeout=3)"

ENTRYPOINT ["python", "-m", "kogwistar_llm_wiki.representation_service"]
