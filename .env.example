############################################
# Kogwistar / LLM-Wiki local environment
############################################

# Shared app data
KOGWISTAR_DATA_DIR=logs/llm_wiki_data

# Preferred multimodal path: private GPU vLLM embedding service. The REST/MCP
# image remains Torch-free. Compose with compose.embedding-vllm.yml.
# The custom Transformers service below is a reference/CPU fallback only.
# LLM_WIKI_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
# LLM_WIKI_EMBEDDING_MODEL_REVISION=<immutable-huggingface-commit>
# LLM_WIKI_EMBEDDING_DIMENSION=1024
# LLM_WIKI_EMBEDDING_TORCH_BACKEND=cpu
# LLM_WIKI_EMBEDDING_TOKEN=
# LLM_WIKI_EMBEDDING_SERVICE_ALLOWED_HOSTS=embedding
# LLM_WIKI_EMBEDDING_IMAGE=kogwistar-llm-wiki-embedding:local
# No legacy service variable aliases are supported; use the canonical names above.

# Experimental direct vLLM backend (GPU-only; do not combine with the
# Transformers Embedding Service overlay). Every value is required when
# LLM_WIKI_MULTIMODAL_BACKEND=vllm. The image must include an immutable digest.
# LLM_WIKI_MULTIMODAL_BACKEND=vllm
# LLM_WIKI_EMBEDDING_VLLM_URL=http://embedding:8000
# LLM_WIKI_EMBEDDING_VLLM_TOKEN=
# LLM_WIKI_EMBEDDING_VLLM_IMAGE=vllm/vllm-openai@sha256:<64-hex-digest>
# LLM_WIKI_EMBEDDING_VLLM_ALLOWED_HOSTS=embedding
# LLM_WIKI_EMBEDDING_VLLM_TIMEOUT_SECONDS=30

# Parser selection
KOGWISTAR_PARSER_PROVIDER=ollama
KOGWISTAR_PARSER_MODEL=gemma4:e2b
KOGWISTAR_PARSER_TEMPERATURE=0.1
# Docker Compose reaches a host Ollama instance through host.docker.internal.
# For a non-container local CLI run, override this with localhost:11434.
KOGWISTAR_PARSER_BASE_URL=http://host.docker.internal:11434
KOGWISTAR_PARSER_API_KEY_ENV=
KOGWISTAR_PARSER_PROJECT=
KOGWISTAR_PARSER_LOCATION=
KOGWISTAR_PARSER_MAX_RETRIES=2

# Optional accounting rate card, in USD per 1,000 tokens. If omitted, reports
# mark provider cost as unavailable rather than treating missing cost as $0.
# KOGWISTAR_PARSER_INPUT_COST_PER_1K_TOKENS=
# KOGWISTAR_PARSER_CACHED_INPUT_COST_PER_1K_TOKENS=
# KOGWISTAR_PARSER_OUTPUT_COST_PER_1K_TOKENS=

# Maintenance selection
KOGWISTAR_MAINTENANCE_PROVIDER=ollama
KOGWISTAR_MAINTENANCE_MODEL=gemma4:e2b
KOGWISTAR_MAINTENANCE_TEMPERATURE=0.1
KOGWISTAR_MAINTENANCE_BASE_URL=http://host.docker.internal:11434
KOGWISTAR_MAINTENANCE_API_KEY_ENV=
KOGWISTAR_MAINTENANCE_PROJECT=
KOGWISTAR_MAINTENANCE_LOCATION=
KOGWISTAR_MAINTENANCE_MAX_RETRIES=2

# Embeddings default to the deterministic test/demo implementation when unset.
# Application-owned settings override the legacy KG_DOC_EMBED_* settings.
# KOGWISTAR_LLM_WIKI_EMBED_PROVIDER=ollama
# KOGWISTAR_LLM_WIKI_EMBED_MODEL=qwen3-embedding:0.6b
# KOGWISTAR_LLM_WIKI_EMBED_BASE_URL=http://localhost:11434
# KOGWISTAR_LLM_WIKI_EMBED_DIMENSION=1024
# Space-specific variants are available, for example:
# KOGWISTAR_LLM_WIKI_KNOWLEDGE_EMBED_MODEL=qwen3-embedding:0.6b
# KOGWISTAR_LLM_WIKI_KNOWLEDGE_EMBED_DIMENSION=1024

# Legacy kg-doc-parser compatibility
KG_DOC_PARSER_PROVIDER=ollama
KG_DOC_PARSER_MODEL=gemma4:e2b
KG_DOC_PARSER_TEMPERATURE=0.1
KG_DOC_PARSER_BASE_URL=http://localhost:11434
KG_DOC_PARSER_API_KEY_ENV=
KG_DOC_PARSER_PROJECT=
KG_DOC_PARSER_LOCATION=
KG_DOC_PARSER_MAX_RETRIES=2

# Azure OpenAI example placeholders
# Use provider=openai or provider=azure_openai in your own env conventions,
# then point the parser/maintenance model at your Azure deployment name.
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://your-resource.openai.azure.com/
OPENAI_API_VERSION=2024-12-01-preview
OPENAI_MODEL=gpt-4o
OPENAI_DEPLOYMENT_NAME=gpt4o

OPENAI_API_KEY_GPT4_1=your-openai-gpt4-1-key
OPENAI_DEPLOYMENT_ENDPOINT_GPT4_1=https://your-resource.openai.azure.com/
OPENAI_DEPLOYMENT_NAME_GPT4_1=gpt41
OPENAI_MODEL_NAME_GPT4_1=gpt-4.1
OPENAI_DEPLOYMENT_VERSION_GPT4_1=2024-12-01-preview

OPENAI_API_KEY_GPT4O=your-openai-gpt4o-key
OPENAI_DEPLOYMENT_ENDPOINT_GPT4O=https://your-resource.openai.azure.com/
OPENAI_DEPLOYMENT_NAME_GPT4O=gpt4o
OPENAI_MODEL_NAME_GPT4O=gpt-4o
OPENAI_DEPLOYMENT_VERSION_GPT4O=2024-12-01-preview

OPENAI_API_KEY_GPT5_MINI=your-openai-gpt5-mini-key
OPENAI_DEPLOYMENT_ENDPOINT_GPT5_MINI=https://your-resource.openai.azure.com/
OPENAI_DEPLOYMENT_NAME_GPT5_MINI=gpt5-mini
OPENAI_MODEL_NAME_GPT5_MINI=gpt-5-mini
OPENAI_DEPLOYMENT_VERSION_GPT5_MINI=2024-12-01-preview

OPENAI_API_KEY_GPT5_NANO=your-openai-gpt5-nano-key
OPENAI_DEPLOYMENT_ENDPOINT_GPT5_NANO=https://your-resource.openai.azure.com/
OPENAI_DEPLOYMENT_NAME_GPT5_NANO=gpt5-nano
OPENAI_MODEL_NAME_GPT5_NANO=gpt-5-nano
OPENAI_DEPLOYMENT_VERSION_GPT5_NANO=2024-12-01-preview

GOOGLE_API_KEY=your-google-api-key
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Optional local Ollama defaults
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434


POSTGRES_PASSWORD=
LLM_WIKI_API_TOKEN=
LLM_WIKI_MCP_TOKEN=


# Published application image
LLM_WIKI_IMAGE=profchan/kogwistar-llm-wiki:v0.3.2

# PostgreSQL
POSTGRES_USER=llm_wiki
POSTGRES_DB=llm_wiki
# Ports
LLM_WIKI_REST_PORT=8765
LLM_WIKI_MCP_PORT=8780
LLM_WIKI_GRAFANA_PORT=3000

# Authentication
# Personal/local mode is represented by the supported "disabled" value.
LLM_WIKI_AUTH_MODE=disabled
LLM_WIKI_AUTH_REQUIRED=false
LLM_WIKI_AGENT_API_ENABLED=true

# OpenTelemetry
LLM_WIKI_OTEL_ENABLED=false
LLM_WIKI_OTEL_SERVICE_NAME=kogwistar-llm-wiki
# Optional OTLP/HTTP collector endpoints. The signal-specific value wins and
# is used verbatim. A base endpoint is normalized to /v1/traces by the app.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# vLLM GPU overlay
LLM_WIKI_EMBEDDING_VLLM_IMAGE=vllm/vllm-openai@sha256:c2914767605584b6d8f45686b82de173ecc99e781897aa3d0a66dacd72c51ae1
LLM_WIKI_MULTIMODAL_MODEL_REVISION=9f2f7e710d6d81056aa5c0a4f04764fec6bb7bda
LLM_WIKI_EMBEDDING_VLLM_TOKEN=change-me
LLM_WIKI_EMBEDDING_GPU_MEMORY_UTILIZATION=0.86
# Safe long-context profile for the tested 8 GiB GPU. Text is cropped to the
# token budget before embedding, leaving prompt/vision and scheduler headroom.
LLM_WIKI_EMBEDDING_MAX_MODEL_LEN=8192
LLM_WIKI_EMBEDDING_CROP_TOKEN_BUDGET=7680
LLM_WIKI_EMBEDDING_VLLM_ENFORCE_EAGER=1
LLM_WIKI_EMBEDDING_VLLM_MAX_NUM_SEQS=1
# Use 0 for Docker Desktop/WSL2 when vLLM reports "UVA is not available".
# Native Linux NVIDIA hosts can try 1 after validating UVA support.
LLM_WIKI_EMBEDDING_VLLM_USE_V2_MODEL_RUNNER=0
