        "KOGWISTAR_LONGRUN_RUN_DIR": "${workspaceFolder}\\tests\\_tmp\\longrun-vscode-postgres-small",
        "KOGWISTAR_OLLAMA_MODEL": "${input:longrunOllamaModel}",
        "KOGWISTAR_OLLAMA_BASE_URL": "http://localhost:11434"
      }
    }
  ],
  "inputs": [
    {
      "id": "demoParserLane",
      "type": "pickString",
