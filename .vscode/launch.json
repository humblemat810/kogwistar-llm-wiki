        "gpt-4.1-mini",
        "gpt-4.1-nano",
        "gpt-5-chat",
        "gpt-5-mini",
        "gpt-5-nano",
        "gpt-5.2-chat",
        "gpt-5.3-chat"
      ]
    },
    {
      "id": "longrunParser",
      "type": "pickString",
      "description": "Long-run parser lane",
