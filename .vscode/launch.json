{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo: Ollama (gemma4:e2b)",
      "type": "debugpy",
      "request": "launch",
      "module": "kogwistar_llm_wiki",
      "envFile": "${workspaceFolder}\\.env",
      "args": [
        "demo",
        "--workspace",
        "demo",
        "--source",
        "${workspaceFolder}\\logs\\llm_wiki_demo\\my_document.md",
        "--vault",
        "${workspaceFolder}\\logs\\llm_wiki_demo\\vault",
        "--title",
        "My Document",
        "--source-format",
        "markdown",
        "--parser-mode",
        "ollama",
        "--parser-lane",
        "${input:demoParserLane}",
        "--llm-provider",
        "ollama",
        "--llm-model",
        "gemma4:e2b",
        "--promotion-mode",
        "sync"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "KOGWISTAR_PARSER_PROVIDER": "ollama",
        "KOGWISTAR_PARSER_MODEL": "gemma4:e2b",
        "KOGWISTAR_PARSER_BASE_URL": "http://localhost:11434",
        "KOGWISTAR_MAINTENANCE_PROVIDER": "ollama",
        "KOGWISTAR_MAINTENANCE_MODEL": "gemma4:e2b",
        "KOGWISTAR_MAINTENANCE_BASE_URL": "http://localhost:11434"
      }
    },
