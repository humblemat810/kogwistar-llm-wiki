# Non-secret local maintenance profile for llama.cpp/Bonsai.
# Merge with the root .env.example values in the local Compose .env. Keep its
# required PostgreSQL credentials; this file is a maintenance profile snippet,
# not a complete standalone Compose environment. Do not commit real keys.

KOGWISTAR_MAINTENANCE_PROVIDER=openai
KOGWISTAR_MAINTENANCE_PROVIDER_CHAIN=openai
KOGWISTAR_MAINTENANCE_MODEL=Ternary-Bonsai-2-27B-PTQ1_0
# Replace with the current WSL virtual-network IPv4. Do not assume
# host.docker.internal resolves to the interface llama-server is bound to.
KOGWISTAR_MAINTENANCE_BASE_URL=http://192.168.64.1:8181/v1
KOGWISTAR_MAINTENANCE_API_KEY_ENV=LLM_WIKI_LOCAL_MODEL_API_KEY
LLM_WIKI_LOCAL_MODEL_API_KEY=local-bonsai

LLM_WIKI_MAINTENANCE_ENABLED=true
LLM_WIKI_MAINTENANCE_REQUEST_ENABLED=true
# Scheduled maintenance reviews only existing sources. Do not add more sources
# until graph-quality review passes.
LLM_WIKI_MAINTENANCE_BACKGROUND_ENABLED=true
LLM_WIKI_REST_MEMORY_LIMIT=512m
LLM_WIKI_REST_CPU_LIMIT=0.25
LLM_WIKI_GRAFANA_MEMORY_LIMIT=640m
LLM_WIKI_GRAFANA_CPU_LIMIT=0.25
LLM_WIKI_MAINTENANCE_BACKGROUND_INTERVAL=300
LLM_WIKI_MAINTENANCE_BACKGROUND_MAX_LLM_CALLS=2
LLM_WIKI_MAINTENANCE_BACKGROUND_MAX_TOKENS=16000
LLM_WIKI_MAINTENANCE_BACKGROUND_MAX_STEPS=6
LLM_WIKI_MAINTENANCE_BACKGROUND_MAX_TIME_SECONDS=300
LLM_WIKI_MAINTENANCE_BACKGROUND_OBSERVATION_TOKEN_BUDGET=4000

# Keep llama-server bound to the WSL interface reachable from this Compose
# network, not 0.0.0.0. Refresh this address after Docker/WSL network changes.
